rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid}/{document=**} {
      allow read, write: if owner(uid);
    }

    // Le letture dei professionisti e la creazione di proposte
    // devono essere abilitate solo tramite regole basate sui link attivi
    // e sui permessi granulari salvati lato server.
  }
}
